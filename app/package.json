  "version": "21.29.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/stamp-dist.mjs",
    "preview": "vite preview",
    "start": "node server/index.js",
    "serve": "node server/index.js",
    "start:telegram": "node telegram-bot/bot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:routes": "node scripts/check-api-routes.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:version && npm test && npm run build && npm run check:routes",
    "lint": "eslint server src --no-error-on-unmatched-pattern",
    "check:version": "node scripts/check-version.mjs",
    "audit:all": "npm audit --omit=dev && npm --prefix telegram-bot audit --omit=dev",
    "calibrate": "node scripts/botlab-calibrate.mjs",
    "backup-state": "node scripts/backup-state.mjs"
  },
  "dependencies": {
    "compression": "^1.8.2",
