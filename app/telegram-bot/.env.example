# ============================================
# Advance Pro Intelligence — Telegram Bot Configuration
# Version 18.0
# ============================================

# Telegram Bot Credentials (server-side only — never expose to browser)
TG_TOKEN=your_bot_token_here
TG_CHAT_ID=your_chat_id_here

# ============================================
# 7-Engine LLM Smart Router (any subset works)
# All keys are optional — Quant Brain fallback is always available
# ============================================

# NVIDIA NIM API (Llama 3.3 70B / Nemotron)
# Get from: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_key_here

# Google Gemini API (gemini-2.5-flash)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Groq API (ultra-fast Llama 4 Scout)
# Get from: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# Anthropic Claude API (Sonnet 4)
# Get from: https://console.anthropic.com
CLAUDE_API_KEY=your_anthropic_key_here

# OpenRouter API (free Llama 3.3 70B)
# Get from: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here

# Cerebras API (ultra-fast GPT-OSS 120B)
# Get from: https://cerebras.ai
CEREBRAS_API_KEY=your_cerebras_key_here

# HuggingFace API (Qwen3 32B)
# Get from: https://huggingface.co/settings/tokens
HF_API_KEY=your_hf_key_here

# Tavily Search API (real-time news, FII/DII, IPOs, earnings)
# Get from: https://tavily.com
TAVILY_API_KEY=tvly_your_tavily_key_here

# ============================================
# Optional Integrations
# ============================================

# Google Apps Script endpoint (cloud portfolio sync)
API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# API_TOKEN for cloud sync auth (must match the web app)
API_TOKEN=replace_with_strong_12plus_char_secret

# Backend URL for fundamentals API (used by /quality command)
# If the bot runs standalone, set this to the deployed backend URL
# FUNDAMENTALS_API_URL=http://localhost:8080

# ML service URL (used by /ml, /mlregime, /mlbacktest, /rebalance)
# ML_SERVICE_URL=http://localhost:8000

# Set to "true" to disable the embedded Express server (bot-only mode)
# BOT_ONLY=true

# Allowed origins for CORS (comma-separated)
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Express port (defaults to 3000)
# PORT=3000

# ============================================
# v18.2 UNIFICATION + v10.9 UPGRADES
# ============================================
# /scan, /screener, /consensus, /regime ab SITE ke SAME backend routes
# use karte hain (one source of truth — bot aur site ka answer match
# karega). The bridge needs API_TOKEN (upar set hai) to be THE SAME
# value as the site's env, and the site running on PORT (same box or
# reachable loopback). Unreachable → every command falls back to its
# legacy local path (bot never goes dark).
#
# 🎤 VOICE NOTES (#5): voice messages transcribe via Groq Whisper
# large-v3 (GROQ_API_KEY upar) with Gemini inline-audio fallback
# (GEMINI_API_KEY) — dono optional, ek hona chahiye. Transcript wahi
# desk agent chalaata hai jo text questions chalata hai.
#
# ⚡ INSTANT PUSH (#2): the site's server/ai/telegramPush.js sink pushes
# SL/TP touches + STRONG signals in seconds; is bot ka 10-min algo cron
# ab sirf backup heartbeat hai (insta-push stale/unreachable hone par
# hi fire karta hai — /api/ai/insta-push/status se check karta hai).
#
# 📊 /weeklyreview (#3): site ke POST /api/ai/weekly-review se aata hai
# (journal + calibration, quant-computed numbers + LLM narration).
