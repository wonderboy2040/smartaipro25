# SmartAI Pro Telegram bot - minimum configuration
# The bot also reads app/.env (server env) automatically, so the normal
# Start-SmartAI-Watchdog.bat launch needs NO extra file here.
#
# Telegram bot token from @BotFather (never commit the real value).
TG_TOKEN=
# Owner chat id. Normally already present in app/.env; the bot never echoes
# raw user/chat ids (the /id command only shows a masked value).
TG_CHAT_ID=
# Same server-only service token as app/.env API_TOKEN (required for site API).
API_TOKEN=
# Local server port (server/.env PORT). Default 8080.
PORT=8080
# Optional overrides:
# BOT_API_BASE_URL=http://127.0.0.1:8080
# BOT_LOG_LEVEL=info
# BOT_STATE_FILE=./.state.json
# BOT_POLL_TIMEOUT_SEC=10
