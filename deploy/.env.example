# ============================================================
# deploy/.env.example — Jev Bot Lab v20.8.2 (plan §17)
# ------------------------------------------------------------
# Copy to deploy/.env, fill values, chmod 600. NEVER commit the
# filled file. Keys with withdrawal permission are BANNED —
# trading permission only (plan §11.3 zero-trust).
# ============================================================

# ---- REQUIRED: app authentication (server REFUSES to boot without
# it — validateEnv exits 1, and restart:always turns that into a
# crash loop; v20.8.2 FIX because this template omitted it) ----
APP_PIN=1234

# ---- existing site keys (see app/.env docs in README) ----
# GROQ_API_KEY=
# GEMINI_API_KEY=
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=

# ---- Jev Bot Lab (v20.8.0) ----
# Jev (TypeSafe System One) — alag key, rotate karne layak
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_THRESHOLD=0.30
JEV_FALLBACK=wait

# ---- AI MODE (v21.14: Laya removed — jev-only) ----
# v21.14.0: Laya local AI model permanently removed. Purane LAYA_* vars
# ab code me padhe nahi jate (safe to delete from your .env).
BOTS_ARM=gated
AI_SHADOW=off
AI_CONSENSUS_ON_DOWN=wait
# JEV_BASE_URL=https://api.typesafe.ai    # (ya JEV_URL= full endpoint)
# JEV_TIMEOUT_MS=4000

# Dhan data APIs (5 req/s throttle default; Data APIs plan check karo)
DHAN_RATE_LIMIT_PER_SEC=5

# Bots runtime — PAPER default. LIVE sirf conscious deploy pe.
BOTS_MODE=PAPER
BOTS_ENABLED=orb_in,orb_crypto_utc,lvl
# Bot state dir (accounts, kill switches, jev cache, candle store).
# Leave EMPTY to use the code default: app/data/bots (relative to the
# app/ dir; the Docker image pins it to /app/server/data/bots and
# docker-compose mounts that path as a volume — v20.8.2 corrected the
# earlier comment that claimed the default was app/server/data/bots).
BOT_STATE_DIR=

# ---- Telegram (v20.9.3: documented for the Docker path) ----
# The image forks the Telegram poller when TG_TOKEN is set; the bot's
# site bridge needs API_TOKEN (= APP_PIN), its LLM relay needs
# BOT_API_SECRET, and webhook mode needs TELEGRAM_WEBHOOK_SECRET.
# TG_TOKEN=
# TG_CHAT_ID=
# BOT_API_SECRET=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_URL=
